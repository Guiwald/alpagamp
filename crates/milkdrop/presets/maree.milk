MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
fRating=3.000000
fGammaAdj=1.600000
fDecay=1.000000
fVideoEchoZoom=1.000000
fVideoEchoAlpha=0.000000
nVideoEchoOrientation=0
nWaveMode=7
bAdditiveWaves=0
bWaveDots=0
bWaveThick=1
bModWaveAlphaByVolume=0
bMaximizeWaveColor=1
bTexWrap=1
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.900000
fWaveScale=1.200000
fWaveSmoothing=0.600000
fWaveParam=0.000000
fModWaveAlphaStart=0.750000
fModWaveAlphaEnd=0.950000
fWarpAnimSpeed=1.000000
fWarpScale=1.000000
fZoomExponent=1.000000
fShader=1.000000
zoom=1.000000
rot=0.000000
cx=0.500000
cy=0.500000
dx=0.000000
dy=0.000000
warp=0.000000
sx=1.000000
sy=1.000000
wave_r=1.000000
wave_g=1.000000
wave_b=1.000000
wave_x=0.500000
wave_y=0.500000
ob_size=0.000000
ob_r=0.000000
ob_g=0.000000
ob_b=0.000000
ob_a=0.000000
ib_size=0.000000
ib_r=0.000000
ib_g=0.000000
ib_b=0.000000
ib_a=0.000000
nMotionVectorsX=12.000000
nMotionVectorsY=9.000000
mv_dx=0.000000
mv_dy=0.000000
mv_l=0.900000
mv_r=1.000000
mv_g=1.000000
mv_b=1.000000
mv_a=0.000000
per_frame_1=wave_r = 0.9; wave_g = 0.9; wave_b = 1;
per_frame_2=zoom = 1.005;
per_frame_3=rot = 0.004*sin(time*0.3);
warp_1=`shader_body
warp_2=`{
warp_3=`    float2 d = uv - 0.5;
warp_4=`    float2 uv2 = uv + float2(sin(time*0.30 + d.y*7.0), cos(time*0.27 + d.x*7.0))*0.0025;
warp_5=`    ret = tex2D(sampler_main, uv2).xyz*0.972;
warp_6=`    ret -= 0.002;
warp_7=`}
comp_1=`shader_body
comp_2=`{
comp_3=`    float3 c = tex2D(sampler_main, uv).xyz;
comp_4=`    float l = dot(c, float3(0.33, 0.33, 0.33));
comp_5=`    ret = c*1.3 + float3(0.04, 0.0, 0.10)*l*bass;
comp_6=`    ret = lerp(ret, ret.zxy, 0.5 + 0.5*sin(time*0.2));
comp_7=`}
